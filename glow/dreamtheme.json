{
  "document": {
    "color": "#eee",
    "margin": 2
  },
  "heading": {
    "color": "#40E0D0",
    "bold": true
  },
  "h1": {
    "color": "#40E0D0",
    "bold": true,
    "prefix": "# "
  },
  "h2": {
    "color": "#FF1493",
    "bold": true,
    "prefix": "## "
  },
  "h3": {
    "color": "#FFD700",
    "bold": true,
    "prefix": "### "
  },
  "h4": {
    "color": "#8A2BE2",
    "bold": true,
    "prefix": "#### "
  },
  "h5": {
    "color": "#8A2BE2",
    "bold": true
  },
  "h6": {
    "color": "#8A2BE2",
    "bold": true
  },
  "link": {
    "color": "#40E0D0",
    "underline": true
  },
  "link_text": {
    "color": "#40E0D0",
    "bold": true
  },
  "strong": {
    "color": "#FFD700",
    "bold": true
  },
  "emph": {
    "color": "#FF1493",
    "italic": true
  },
  "code": {
    "color": "#8A2BE2"
  },
  "code_block": {
    "color": "#ddd",
    "margin": 2
  },
  "list": {
    "color": "#eee",
