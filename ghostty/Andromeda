# --- background image (Ghostty 1.2.0+).
#     The wallpaper ships with this repo (config/ghostty/wallpapers/), so there
#     is nothing to download. {{DOTFILES}} is substituted with the real repo
#     path by install.sh, which writes this file rather than symlinking it —
#     Ghostty needs an absolute path here and the repo location varies by
#     machine. Edit the copy in the repo, then re-run ./install.sh ghostty.
background-image = {{DREAMTHEME}}/warp/jellyfish_bg.jpg
background-image-opacity = 0.30
background-image-fit = cover
background-image-position = center
background-image-repeat = false
